.noosphere/ide-hint.json
.noosphere/*.tmp
.noosphere/*.lock
.noosphere/journal.md
noosphere-relayer/.noosphere-local-memory.json
noosphere-relayer/.noosphere-runtime/

# motion-dev MCP offline cache, regenerated on demand
docs/motion-docs.db
.noosphere/instructions.md
.noosphere/commit-observations.json
.noosphere/pending-journal.md
.noosphere/inferred-state.json
