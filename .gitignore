# Dependencies
node_modules/

# Runtime state
demo_blobs/
project_registry.json
*.tmp

# Test temp dirs
tests/.tmp-*

# Environment secrets
.env
.env.local
.env.*.local
# Deployment secrets (only the *.example templates are tracked)
deploy/noosphere.env
deploy/**/*.env
!deploy/**/*.env.example

# macOS
.DS_Store
._*

