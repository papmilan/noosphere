# Noosphere Remote Project Memory — environment template.
#
# Copy to deploy/noosphere.env (git-ignored) and replace every placeholder with
# a real value. NONE of the values below are usable as-is; they are structural
# examples, not credentials. See docs/remote-mcp/CONFIGURATION.md for the full
# reference (purpose / required / default / security notes for each key).

# ---- Identity / OAuth 2.1 protected-resource -------------------------------
# The audience (resource identifier) this server accepts tokens for. Must match
# the `aud` your OIDC provider mints and the URL clients discover.
NOOSPHERE_AUDIENCE=https://REPLACE_ME.example/project-memory

# Absolute URL of this server's RFC 9728 protected-resource metadata document.
NOOSPHERE_RESOURCE_METADATA_URL=https://REPLACE_ME.example/.well-known/oauth-protected-resource

# Authorization servers advertised in that metadata (space/comma separated).
NOOSPHERE_AUTHORIZATION_SERVERS=https://REPLACE_ME.oidc.example/

# Trusted issuers as a JSON array. jwks_uri MUST be https. Add one object per
# issuer you accept tokens from.
NOOSPHERE_OIDC_ISSUERS=[{"iss":"https://REPLACE_ME.oidc.example/","jwks_uri":"https://REPLACE_ME.oidc.example/.well-known/jwks.json"}]

# Scopes every request token must carry (space/comma separated). Empty = none.
NOOSPHERE_REQUIRED_SCOPES=project.read project.write

# Browser origins allowed to call /mcp (space/comma separated). Empty = none
# (non-browser clients send no Origin and are unaffected).
NOOSPHERE_ALLOWED_ORIGINS=https://app.REPLACE_ME.example

# ---- Runtime ---------------------------------------------------------------
# Must be true in production. Enables strict checks and forbids test identities.
NOOSPHERE_PRODUCTION=true

# Required in production. Generate once (for example, `openssl rand -base64 48`),
# store it as a secret, and use the same value on every replica. Rotating it
# invalidates pagination cursors that clients have not consumed yet.
NOOSPHERE_CURSOR_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES

# postgres (required in production) or memory (ephemeral; non-production only).
NOOSPHERE_REPOSITORY=postgres

# Port the HTTP server listens on inside the container.
NOOSPHERE_PORT=8080

# json (default) or silent. Structured JSON is recommended in production.
NOOSPHERE_LOG=json

# Optional: max request body in bytes (default 1048576 = 1 MiB, ceiling 64 MiB).
# NOOSPHERE_MAX_BODY_BYTES=1048576

# Optional: idle MCP transport-session TTL in milliseconds (default 1800000 =
# 30 minutes, maximum 604800000 = 7 days).
# NOOSPHERE_MCP_SESSION_TTL_MS=1800000

# Optional: process-wide cap on live MCP transport sessions (default 1000,
# maximum 100000). New initialization requests receive 503 when occupied.
# NOOSPHERE_MAX_MCP_SESSIONS=1000

# Optional: per-owner project quota. Unset = unlimited.
# NOOSPHERE_PROJECTS_PER_OWNER=100

# ---- Database --------------------------------------------------------------
# Connection string for the PostgreSQL control plane. Keep the password out of
# shell history and process listings where possible (use a secrets manager /
# file-based secret in real deployments).
DATABASE_URL=postgres://REPLACE_ME_USER:REPLACE_ME_PASSWORD@db:5432/noosphere_project_memory

# ---- docker-compose db bootstrap (compose file only) -----------------------
# These initialise the bundled `db` service. Keep them consistent with
# DATABASE_URL above.
POSTGRES_USER=REPLACE_ME_USER
POSTGRES_PASSWORD=REPLACE_ME_PASSWORD
POSTGRES_DB=noosphere_project_memory
