{
  "name": "noosphere-continuity",
  "version": "2.1.0",
  "private": true,
  "description": "Automatic cross-agent continuity backed by Walrus Memory",
  "type": "module",
  "bin": {
    "noosphere": "continuity/index.js"
  },
  "scripts": {
    "continuity:init": "node continuity/index.js init",
    "continuity:watch": "node continuity/index.js watch",
    "continuity:checkpoint": "node continuity/index.js checkpoint",
    "continuity:refresh": "node continuity/index.js refresh",
    "check": "node --check continuity/index.js && node --test tests/*.test.js",
    "test": "node --test tests/*.test.js"
  },
  "engines": {
    "node": ">=20"
  }
}
