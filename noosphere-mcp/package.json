{
  "name": "noosphere-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Claude Code hook and MCP server for Noosphere shared memory",
  "type": "module",
  "main": "mcp-server/index.js",
  "scripts": {
    "start": "node mcp-server/index.js",
    "start:stdio": "node mcp-server/index.js --stdio",
    "start:sse": "node mcp-server/index.js --sse",
    "check": "node --check mcp-server/index.js",
    "test": "node --test tests/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "express": "5.2.1",
    "zod": "^3.25.76"
  }
}
