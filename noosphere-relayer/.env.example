PORT=3001

# Use gitignored plaintext local persistence for development and tests.
DEMO_MODE=true
LOCAL_MEMORY_PATH=.noosphere-local-memory.json

# Privacy-first default: no project content is sent to a separate evaluator.
SCORING_MODE=private

# Optional. Set SCORING_MODE=remote to enable Anthropic evaluation.
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Walrus Memory delegate credentials from https://memory.walrus.xyz/
MEMWAL_PRIVATE_KEY=
MEMWAL_ACCOUNT_ID=
MEMWAL_SERVER_URL=https://relayer-staging.memory.walrus.xyz
MEMWAL_NAMESPACE_PREFIX=noosphere
MEMWAL_REMEMBER_TIMEOUT_MS=120000
