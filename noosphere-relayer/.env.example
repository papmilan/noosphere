PORT=3001
DEMO_MODE=false
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY

# Optional override used by tests or compatible API gateways.
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Deployed Noosphere package on Sui testnet.
PACKAGE_ID=0xb5df3bb6b56fd01190a3ee422ae8dba97b775b050cdc68de75b1db3df3e870cc

# Base64-encoded Sui private key. Supports a raw 32-byte Ed25519 key or
# a 33-byte Sui keystore value containing the signature-scheme flag.
RELAYER_PRIVATE_KEY=YOUR_BASE64_PRIVATE_KEY

# Dedicated scorer identity. Keep this separate from RELAYER_PRIVATE_KEY.
# Scores are signed as Sui personal messages before actions are stored.
SCORER_PRIVATE_KEY=YOUR_BASE64_SCORER_PRIVATE_KEY

SUI_RPC_URL=https://fullnode.testnet.sui.io:443

# Used as an HTTP fallback when a direct SDK read is unavailable.
WALRUS_AGGREGATOR_URL=https://aggregator.walrus-testnet.walrus.space

# Optional but recommended. It reduces the number of requests required
# to upload through the Walrus SDK.
WALRUS_UPLOAD_RELAY_URL=https://upload-relay.testnet.walrus.space
WALRUS_EPOCHS=200
