# When changing PORT or HOST, also set NOOSPHERE_RELAYER_URL in the
# environment of noosphere-mcp so the CLI reaches the same address,
# or set `relayer_url` in each project's .noosphere/config.json.
PORT=3001
HOST=127.0.0.1

# Required for NODE_ENV=production or any non-loopback HOST.
# Generate with: openssl rand -hex 32
NOOSPHERE_API_TOKEN=
# Local tools may omit the token while the server is loopback-only.
# Production and non-loopback modes always disable this bypass.
ALLOW_LOOPBACK_WITHOUT_TOKEN=true

# Comma-separated exact browser origins. Wildcards are not accepted.
CORS_ORIGINS=http://127.0.0.1:3001,http://localhost:3001
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Set to 1 when running behind one trusted reverse proxy
# (Nginx, Cloudflare, etc.).
# Required for correct base URLs in OpenAPI and discovery docs when proxied.
# TRUST_PROXY=1

# Production-safe default: use Walrus Memory. `npm run demo` explicitly
# enables gitignored local persistence for development.
DEMO_MODE=false
LOCAL_MEMORY_PATH=.noosphere-local-memory.json

# Durable queue and restart-safe idempotency receipts.
NOOSPHERE_STATE_PATH=.noosphere-runtime/state.json
UPLOAD_RETRY_ATTEMPTS=3
UPLOAD_RETRY_BASE_MS=1000

# Walrus Memory delegate credentials from https://memory.walrus.xyz/
MEMWAL_NETWORK=mainnet
MEMWAL_PRIVATE_KEY=
MEMWAL_ACCOUNT_ID=
# Optional overrides. Defaults are selected from MEMWAL_NETWORK.
# MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz
# MEMWAL_SUI_RPC_URL=https://fullnode.mainnet.sui.io:443
MEMWAL_NAMESPACE_PREFIX=noosphere
MEMWAL_REMEMBER_TIMEOUT_MS=180000
