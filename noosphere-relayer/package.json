{
  "name": "noosphere-relayer",
  "version": "2.0.4",
  "description": "Local-file or Walrus Memory relay server for Noosphere cross-agent project memory",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "demo": "NOOSPHERE_MEMORY_BACKEND=local-file node index.js",
    "dev": "node --watch index.js",
    "test": "node --experimental-vm-modules --test tests/*.test.js",
    "test:live": "node scripts/live-walrus-smoke.js",
    "check": "node --check index.js && node --check memory.js && node --check local-memory.js && node --check walrus-memory.js && node --check durable-store.js && node --check security.js && node --check credentials.js && node --check local-projects.js && node --check acp-protocol.js && node --check snapshot-backend.js && node --check walrus-snapshot-backend.js && node --check exact-state.js && node --check exact-routes.js"
  },
  "files": [
    "acp-protocol.js",
    "credentials.js",
    "durable-store.js",
    "exact-state.js",
    "exact-routes.js",
    "index.js",
    "local-memory.js",
    "local-projects.js",
    "memory.js",
    "snapshot-backend.js",
    "security.js",
    "walrus-memory.js",
    "walrus-snapshot-backend.js",
    "env.example",
    "npm-shrinkwrap.json",
    "scripts/"
  ],
  "keywords": [
    "ai",
    "agent",
    "memory",
    "walrus",
    "sui",
    "noosphere",
    "relay"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/papmilan/noosphere.git"
  },
  "homepage": "https://github.com/papmilan/noosphere#readme",
  "engines": {
    "node": ">=22"
  },
  "bundleDependencies": [
    "@noosphere/acp-protocol"
  ],
  "dependencies": {
    "@mysten-incubation/memwal": "0.0.7",
    "@mysten/sui": "^2.17.0",
    "@noosphere/acp-protocol": "file:../noosphere-acp-protocol",
    "dotenv": "17.4.2",
    "express": "5.2.1"
  }
}
